# syntax=docker/dockerfile:1
# Multi-stage build: do not ADD the whole install/ tree (saves ~1.5GB in the final image).

FROM ubuntu:22.04 AS builder
COPY install/nm760CD /nonmem/nm760CD
COPY install/PsN-Source /nonmem/PsN-Source
COPY install/psn.conf.nm760 /nonmem/psn.conf.nm760
WORKDIR /nonmem

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        gfortran perl python3 python3-venv python3-dev python3-pip python-is-python3 \
        libmpich-dev mpich unzip cpanminus \
        build-essential autoconf automake make \
    && cpanm --notest Math::Random Moose MooseX::Params::Validate Statistics::Distributions \
        Math::SigFigs Capture::Tiny Math::Random::Free Math::MatrixReal Mouse \
        MouseX::Params::Validate YAML Archive::Zip File::Copy::Recursive File::HomeDir \
        YAML::XS Storable \
    && /bin/bash ./nm760CD/SETUP76 ${PWD}/nm760CD /nonmem/nm760 gfortran y /usr/bin/ar same rec q \
    && cd PsN-Source \
    && perl -i -0pe 's/(Would you like to install the PsNR R package\? \[y\/n\] ";\n\n    )if \(\$auto or confirm\(\)\)/$1if (0)/s' setup.pl \
    && perl -i -0pe 's/(Would you like to install the pharmpy python package\? \[y\/n\] ";\n\n    )if \(\$auto or confirm\(\)\)/$1if (0)/s' setup.pl \
    && perl -i -0pe 's/(Would you like to install the PsN test library\? \[y\/n\] ";\n    )if \(\$auto or confirm\(\)\)/$1if (0)/s' setup.pl \
    && perl setup.pl -auto \
    && PSN_DIR="$(find /usr/local/share/perl -maxdepth 2 -type d -name 'PsN_5_7_1' | head -1)" \
    && test -n "$PSN_DIR" \
    && cp /nonmem/psn.conf.nm760 "${PSN_DIR}/psn.conf" \
    && cp "$(find /usr/lib -name 'libmpich.a' | head -1)" /nonmem/nm760/mpi/mpi_ling/libmpich.a \
    && rm -rf nm760CD PsN-Source psn.conf.nm760 \
        nm760/help nm760/html nm760/guides nm760/examples nm760/run \
        nm760/mpi/mpi_lini nm760/mpi/mpi_wing nm760/mpi/mpi_wini \
        /usr/local/share/perl/*/PsN_test_5_7_1 \
        "${PSN_DIR}/Rlib" \
        /root/.cpanm /root/.cache/pip \
    && rm -f nm760/*.zip nm760/*.pdf nm760/instal* nm760/unzip* \
    && apt-get purge -y --auto-remove \
        build-essential autoconf automake cpanminus unzip \
        python3-dev python3-pip python3-venv libmpich-dev \
    && apt-mark manual libgfortran5 \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /tmp/* \
        /usr/share/doc/* /usr/share/man/* /usr/share/locale/*

FROM ubuntu:22.04
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        gfortran libgfortran5 mpich libmpich-dev perl python3 python3-minimal \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* \
        /usr/share/doc/* /usr/share/man/*

COPY --from=builder /nonmem/nm760 /nonmem/nm760
COPY --from=builder /usr/local/share/perl /usr/local/share/perl
COPY --from=builder /usr/local/lib /usr/local/lib
COPY --from=builder /usr/local/bin /usr/local/bin

WORKDIR /nonmem
ENV PATH="/nonmem/nm760/util:${PATH}"
